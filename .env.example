# Токен бота (Discord Developer Portal → Bot → Token)
DISCORD_TOKEN=

# База данных (SQLite по умолчанию)
DATABASE_URL=sqlite+aiosqlite:///data/akiyama.db

# Привилегированный интент «Message Content»: без него логи удалений/правок
# приходят пустыми. Включить в Discord Developer Portal. false = принудительно
# запуститься без интента (тексты логов будут пустыми).
MESSAGE_CONTENT_INTENT=true

# --- Каналы (0 = не настроен, модуль молчит) ---
# ROSTER_CHANNEL_ID обязателен для состава. Остальные — по мере необходимости.
ROSTER_CHANNEL_ID=
OWNER_CHANNEL_ID=
VZP_CHANNEL_ID=
# Служебный канал: сюда внешний инструмент кладёт JSON с данными войн.
VZP_INGEST_CHANNEL_ID=
APPLICATIONS_CHANNEL_ID=
TICKETS_CATEGORY_ID=
CLOSED_TICKETS_CATEGORY_ID=
CONTROL_PANEL_CHANNEL_ID=
# Канал авто-уведомления и авто-сбора на деф. Пусто → VZP_CHANNEL_ID.
PLUS_DEF_CHANNEL_ID=

# --- Роли ---
# Роль, которую выдаёт бот при заходе на сервер (0 = не настроен).
JOIN_ROLE_ID=

# --- Заявки ---
# Роль состава Main (по умолчанию — Young Staff of Akiyama).
APPLICATION_KIND_MAIN_ROLE_ID=
# Роль состава «онли VZP» (по умолчанию не задана — в меню только текст).
APPLICATION_KIND_VZP_ROLE_ID=
# Семейная роль (тег в сборах «Общий»).
APPLICATION_MEMBER_ROLE_ID=
# Роли, которые выдаются при принятии заявки (через запятую).
APPLICATION_ACCEPT_ROLE_IDS=
# Теги ролей при создании сбора: общий / VZP.
PLUS_PING_GENERAL_ROLE_ID=
PLUS_PING_VZP_ROLE_ID=
# Кто может ставить плюсы на сборах VZP сверх состава и руководства (через запятую).
# По умолчанию — Head VZP; тег VZP и состав «онли VZP» — здесь.
PLUS_VZP_ROLE_IDS=

# --- Эмодзи статуса набора (0 = обычные ✅/❌) ---
APPLICATION_OPEN_EMOJI_ID=
APPLICATION_CLOSED_EMOJI_ID=

# --- Сайт akiyama-5rp.ru (бот и сайт в одном процессе, общая БД) ---
# ОAuth-приложение: Discord Developer Portal → OAuth2 → URL Generator.
# Scopes: identify, guilds. Redirect URL: https://akiyama-5rp.ru/auth/callback
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://akiyama-5rp.ru/auth/callback
# Ключ для подписи cookie сессии панели (openssl rand -hex 32). Обязательно.
WEB_SECRET=
# Онлайн-статистика сервера (gta5masterlist.ru): GTA5RP Richman = serverId 8.
ONLINE_SERVER_ID=8
ONLINE_SERVER_NAME=Richman
# API JSON онлайа (template; {server_id} подставляется).
ONLINE_API_URL=https://gta5masterlist.ru/api/servers/{server_id}/online

# --- Логи (0 = канал не настроен, лог для него не отправляется) ---
LOG_TEXT_CHANNEL_ID=
LOG_VOICE_CHANNEL_ID=
LOG_MEMBER_CHANNEL_ID=
LOG_MODERATION_CHANNEL_ID=
LOG_SERVER_CHANNEL_ID=
LOG_INVITE_CHANNEL_ID=
LOG_AUDIT_CHANNEL_ID=
LOG_BOT_LIVE_CHANNEL_ID=
